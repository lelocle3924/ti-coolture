# ==============================================================================
# TÍ COOLTURE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Sao chép file này thành .env.local khi chạy local hoặc cấu hình trên Vercel Dashboard.

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE & AUTH
# ------------------------------------------------------------------------------
# URL project Supabase của bạn (ví dụ: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Anon Key (dùng trên Client Frontend để query dữ liệu publish_status = 'published')
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Secret Service Role Key (CHỈ dùng trong Vercel Serverless Functions /api/*, KHÔNG bao giờ lộ ra FE)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# 2. CLOUDFLARE R2 STORAGE (Lưu trữ ảnh trực tiếp, 0đ Egress)
# ------------------------------------------------------------------------------
# Cloudflare Account ID (lấy tại Overview dashboard của Cloudflare)
R2_ACCOUNT_ID=your_cloudflare_account_id_here

# R2 API Token: Access Key ID (tạo tại R2 > Manage R2 API Tokens)
R2_ACCESS_KEY_ID=your_r2_access_key_id_here

# R2 API Token: Secret Access Key
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here

# Tên Bucket R2 đã tạo
R2_BUCKET_NAME=ti-coolture-media

# Tên miền Public truy cập ảnh (Custom Domain hoặc R2 dev URL)
# Ví dụ: https://img.ticoolture.vn hoặc https://pub-xyz.r2.dev
R2_PUBLIC_DOMAIN=https://img.ticoolture.vn

# ------------------------------------------------------------------------------
# 3. NOTIFICATION & REVIEW WEBHOOK (Tùy chọn cho Phase sau)
# ------------------------------------------------------------------------------
# Webhook gửi tin nhắn báo duyệt về Telegram Admin Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ------------------------------------------------------------------------------
# 4. UPSTASH REDIS (Serverless Cache - REST API)
# ------------------------------------------------------------------------------
# Tạo database miễn phí tại https://console.upstash.com (Zero connection pool issues)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

